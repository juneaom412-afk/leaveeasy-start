// ─────────────────────────────────────────────────────────────
// firestore.rules — กฎขั้นต่ำของสัปดาห์ที่ 7 (US-08)
//
// กฎเดียว: "ต้องล็อกอินก่อน ถึงจะอ่านหรือเขียนอะไรได้"
// ยังไม่แยกสิทธิ์ตาม role (employee/manager/hr) — เป็นงานสัปดาห์ที่ 8
//
// วิธีใช้: Firebase Console → โปรเจกต์ leaveeasy-songchai
//          → Firestore Database → แท็บ Rules → วางทับกฎเดิมทั้งหมด → Publish
// ─────────────────────────────────────────────────────────────

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
